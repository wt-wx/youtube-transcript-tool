# === 全局配置 ===
# Node Configuration (LA or HK)
NODE_NAME=[LA_OR_HK]

CREDENTIALS_FILE=credentials.json
SPREADSHEET_NAME=[YOUR_SHEET_NAME]
SHEET_NAME=Production

# === 节点模式 (Node Task) ===
# 可选值: LA (抓取节点), HK (转录节点)
NODE_MODE=[LA_OR_HK]

# === Google Drive / Rclone 路径 ===
# 如果使用 rclone 挂载，请填写挂载点路径
RCLONE_MOUNT_PATH=[MOUNT_PATH]

# === LA 抓取节点配置 ===
DOWNLOAD_RATE_LIMIT=5M
CHANNEL_LIST_SHEET=Channels
FETCH_LIMIT=10
MIN_DELAY=30
MAX_DELAY=120

# === HK 转录节点配置 ===
# 模型大小: small, medium, large-v3
WHISPER_MODEL_SIZE=small
DEVICE=cpu
COMPUTE_TYPE=int8
TRANSCRIPTION_LIMIT=20
CPU_THREADS=4

# === 其他 ===
LOCAL_TEMP_DIR=temp_audio
